---
// input: no component props
// output: site footer with legal links and disclaimer
// pos: shared footer component (update rule: sync this header and src/components README when this file changes)
import { siteConfig } from "../../site.config.mjs";
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <p class="footer-title">{siteConfig.name}</p>
      <p>{siteConfig.disclaimer}</p>
    </div>
    <nav aria-label="Footer navigation">
      <a href="/about/">About</a>
      <a href="/contact/">Contact</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </nav>
    <div>
      <p>Contact: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></p>
      <p>Copyright {siteConfig.year} {siteConfig.owner}.</p>
    </div>
  </div>
</footer>
