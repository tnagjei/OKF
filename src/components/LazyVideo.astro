---
// input: video object containing { embedUrl, title, originalUrl, fallbackText, note }
// output: lazy loaded video element that renders confirmation placeholder card before injecting iframe
// pos: shared component for video performance optimization (update rule: sync this header and src/components README when this file changes)
const { video } = Astro.props;
---

<div class="video-embed lazy-video-container" data-embed-url={video.embedUrl} data-video-title={video.title}>
  <div class="video-placeholder">
    <div class="placeholder-content">
      <div class="play-icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M8 5v14l11-7z"/>
        </svg>
      </div>
      <h3>Watch video</h3>
      <p>Load the embedded video only when needed.</p>
      <button type="button" class="load-video-button">Load video</button>
    </div>
  </div>
</div>
{video.note && (
  <figcaption>
    <span>{video.note}</span>
    {video.originalUrl && <a href={video.originalUrl} rel="noreferrer" target="_blank">{video.fallbackText || "Watch on YouTube"}</a>}
  </figcaption>
)}

<script>
  // 查找所有懒加载视频容器并注入点击事件
  const containers = document.querySelectorAll(".lazy-video-container");
  containers.forEach((container) => {
    const button = container.querySelector(".load-video-button");
    if (button) {
      button.addEventListener("click", () => {
        const embedUrl = container.getAttribute("data-embed-url");
        const title = container.getAttribute("data-video-title") || "Embedded video";
        if (embedUrl) {
          container.innerHTML = `
            <iframe
              src="${embedUrl}"
              title="${title}"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          `;
        }
      });
    }
  });
</script>

<style>
  .lazy-video-container {
    cursor: pointer;
  }
  .video-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    background: radial-gradient(circle, #1e293b 0%, #0f172a 100%);
  }
  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    max-width: 320px;
  }
  .play-icon {
    width: 3.5rem;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #38bdf8;
    color: #0f172a;
    border-radius: 50%;
    margin-bottom: 0.25rem;
    box-shadow: 0 4px 12px rgba(56, 189, 248, 0.3);
    transition: transform 0.2s ease, background-color 0.2s ease;
  }
  .lazy-video-container:hover .play-icon {
    transform: scale(1.08);
    background-color: #7dd3fc;
  }
  .play-icon svg {
    width: 1.75rem;
    height: 1.75rem;
    margin-left: 0.25rem;
  }
  .placeholder-content h3 {
    margin: 0;
    font-size: 1.125rem;
    color: #f8fafc;
    font-weight: 600;
  }
  .placeholder-content p {
    margin: 0;
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.4;
  }
  .load-video-button {
    margin-top: 0.5rem;
    padding: 0.375rem 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #f8fafc;
    background-color: #1e293b;
    border: 1px solid #334155;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .load-video-button:hover {
    background-color: #334155;
    border-color: #475569;
  }
</style>
