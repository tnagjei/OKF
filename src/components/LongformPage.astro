---
// input: page content object
// output: longform page with optional template, example, code block, or video content
// pos: shared content renderer (update rule: sync this header and src/components README when this file changes)
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "./CodeBlock.astro";
import { exampleLibrary, templateLibrary, sourceLinks } from "../data/content";

const { page } = Astro.props;
const library = page.kind === "templates" ? templateLibrary : page.kind === "examples" ? exampleLibrary : [];
const libraryScenarioLabel = page.kind === "examples" ? "Who it is for" : "Use case";
const libraryCodeLabel = page.kind === "examples" ? "Copy-ready example" : "Copy-ready template";
const libraryMistakeLabel = page.kind === "examples" ? "Common mistake" : "Common mistakes";
---

<BaseLayout title={page.title} description={page.description} path={page.path}>
  <main class="page-shell">
    <section class="page-hero narrow-hero">
      <p class="eyebrow">{page.eyebrow}</p>
      <h1>{page.h1}</h1>
      <p class="hero-copy">{page.intro}</p>
    </section>

    {page.sections.map((section) => (
      <section class="content-section">
        <h2>{section.heading}</h2>
        {section.paragraphs?.map((paragraph) => <p set:html={paragraph} />)}
        {section.bullets && (
          <ul class="check-list">
            {section.bullets.map((bullet) => <li set:html={bullet} />)}
          </ul>
        )}
        {section.subsections && (
          <div class="mini-grid">
            {section.subsections.map((item) => (
              <article class="mini-panel">
                <h3>{item.heading}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        )}
        {section.code && <CodeBlock code={section.code.value} label={section.code.label} />}
        {section.video && (
          <figure class="video-frame">
            <div class="video-embed">
              <iframe
                src={section.video.embedUrl}
                title={section.video.title}
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              />
            </div>
            <figcaption>
              <span>{section.video.note}</span>
              <a href={section.video.originalUrl} rel="noreferrer">{section.video.fallbackText}</a>
            </figcaption>
          </figure>
        )}
      </section>
    ))}

    {library.length > 0 && (
      <section class="library-section" aria-label={page.kind === "templates" ? "OKF templates" : "OKF examples"}>
        {library.map((item) => (
          <article class="library-item">
            <div class="library-copy">
              <p class="eyebrow">{page.kind === "templates" ? "Template" : "Example"}</p>
              <h2>{item.title}</h2>
              <h3>{libraryScenarioLabel}</h3>
              <p>{item.scenario}</p>
              <h3>{libraryCodeLabel}</h3>
              <p>Use the code block beside this note as the starting point, then update the sample paths and field values.</p>
              <h3>Field notes</h3>
              <ul>
                {item.fields.map((field) => <li set:html={field} />)}
              </ul>
              <h3>{libraryMistakeLabel}</h3>
              <ul>
                {item.mistakes.map((mistake) => <li>{mistake}</li>)}
              </ul>
              <h3>Recommended next step</h3>
              <p>{item.nextStep}</p>
              {page.kind === "templates" && (
                <p><a href="/okf-validator/">Validate this OKF template</a></p>
              )}
              {page.kind === "examples" && (
                <p><a href="/okf-validator/">Validate this example</a></p>
              )}
            </div>
            <CodeBlock code={item.code} label={item.title} />
          </article>
        ))}
      </section>
    )}

    <section class="content-section source-note">
      <h2>Source boundary</h2>
      <p>
        This guide is unofficial. It uses public draft references for orientation and adds practical examples for learning.
      </p>
      <ul>
        {sourceLinks.map((source) => <li><a href={source.href} rel="noreferrer">{source.label}</a></li>)}
      </ul>
    </section>
  </main>
</BaseLayout>
