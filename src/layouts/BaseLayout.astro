---
// input: title, description, path, and slot content
// output: complete HTML document with SEO metadata and shared chrome
// pos: base page layout (update rule: sync this header and src/layouts README when this file changes)
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import { siteConfig } from "../../site.config.mjs";

const {
  title,
  description,
  path = "/",
  image = "/og-image.png",
  noindex = false
} = Astro.props;

const canonicalUrl = new URL(path, siteConfig.url).href;
const ogImageUrl = new URL(image, siteConfig.url).href;

// 构建结构化数据（JSON-LD）：根据路径推断页面类型，集中输出，避免子页面逐个配置
// 设计意图：所有页面共享 Organization 身份；工具页加 WebApplication；guide/compare 加 Article 系
const organizationLd = {
  "@type": "Organization",
  "@id": `${siteConfig.url}/#organization`,
  name: siteConfig.name,
  url: siteConfig.url,
  logo: `${siteConfig.url}/icon-512.png`,
  email: siteConfig.email
};

const websiteLd = {
  "@type": "WebSite",
  "@id": `${siteConfig.url}/#website`,
  url: siteConfig.url,
  name: siteConfig.name,
  description: siteConfig.disclaimer,
  publisher: { "@id": `${siteConfig.url}/#organization` }
};

const toolPaths = ["/okf-validator/", "/okf-folder-validator/"];
const isToolPage = toolPaths.includes(path);
const isGuide = path.startsWith("/guides/");
const isCompare = path.startsWith("/compare/");

const webApplicationLd = isToolPage
  ? {
      "@type": "WebApplication",
      "@id": `${canonicalUrl}#webapplication`,
      url: canonicalUrl,
      name: title,
      description,
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Any",
      browserRequirements: "Requires a modern web browser with JavaScript enabled.",
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@id": `${siteConfig.url}/#organization` }
    }
  : null;

const articleLd =
  isGuide || isCompare
    ? {
        "@type": isGuide ? "TechArticle" : "Article",
        "@id": `${canonicalUrl}#article`,
        headline: title,
        description,
        url: canonicalUrl,
        author: { "@id": `${siteConfig.url}/#organization` },
        publisher: { "@id": `${siteConfig.url}/#organization` },
        mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl }
      }
    : null;

// 首页输出 WebSite + Organization；其他页面只输出 Organization 身份
// 工具页额外加 WebApplication；guide/compare 额外加 Article 系列
const jsonLdBlocks = [];
if (path === "/") {
  jsonLdBlocks.push({ "@context": "https://schema.org", ...websiteLd });
}
jsonLdBlocks.push({ "@context": "https://schema.org", ...organizationLd });
if (webApplicationLd) {
  jsonLdBlocks.push({ "@context": "https://schema.org", ...webApplicationLd });
}
if (articleLd) {
  jsonLdBlocks.push({ "@context": "https://schema.org", ...articleLd });
}

// 动态计算 siteRoot 域名（非 www、且带尾斜杠）
const siteRoot = siteConfig.url.endsWith("/") ? siteConfig.url : `${siteConfig.url}/`;

// 绝对路径生成函数，确保域名非 www、带尾斜杠且与 canonical 共享数据源
const absoluteUrl = (subPath: string) => {
  const cleanPath = subPath.startsWith("/") ? subPath.slice(1) : subPath;
  return new URL(cleanPath, siteRoot).href;
};

// 规范化 path 为以 / 开头且以 / 结尾的格式；首页 "/" 保持为 "/"
const formatPath = (p: string) => {
  if (p === "/") return "/";
  let clean = p;
  if (!clean.startsWith("/")) clean = "/" + clean;
  if (!clean.endsWith("/")) clean = clean + "/";
  return clean;
};
const normalizedPath = formatPath(path);

const baseBreadcrumb = { name: "Home", item: siteRoot };
const breadcrumbMap: Record<string, { name: string; item: string }[]> = {
  "/what-is-okf/": [
    baseBreadcrumb,
    { name: "What is OKF", item: absoluteUrl("/what-is-okf/") }
  ],
  "/okf-templates/": [
    baseBreadcrumb,
    { name: "Templates", item: absoluteUrl("/okf-templates/") }
  ],
  "/okf-tutorial/": [
    baseBreadcrumb,
    { name: "Tutorial", item: absoluteUrl("/okf-tutorial/") }
  ],
  "/okf-examples/": [
    baseBreadcrumb,
    { name: "Examples", item: absoluteUrl("/okf-examples/") }
  ],
  "/okf-validator/": [
    baseBreadcrumb,
    { name: "Validator", item: absoluteUrl("/okf-validator/") }
  ],
  "/okf-folder-validator/": [
    baseBreadcrumb,
    { name: "Folder Validator", item: absoluteUrl("/okf-folder-validator/") }
  ],
  "/compare/okf-vs-rag/": [
    baseBreadcrumb,
    { name: "OKF vs RAG", item: absoluteUrl("/compare/okf-vs-rag/") }
  ],
  "/compare/okf-vs-mcp/": [
    baseBreadcrumb,
    { name: "OKF vs MCP", item: absoluteUrl("/compare/okf-vs-mcp/") }
  ],
  "/guides/how-to-create-an-okf-bundle/": [
    baseBreadcrumb,
    { name: "How to create an OKF bundle", item: absoluteUrl("/guides/how-to-create-an-okf-bundle/") }
  ],
  "/guides/how-to-validate-okf-files/": [
    baseBreadcrumb,
    { name: "How to validate OKF files", item: absoluteUrl("/guides/how-to-validate-okf-files/") }
  ]
};

// 检查是否命中面包屑映射表
const matchedBreadcrumbs = breadcrumbMap[normalizedPath];
if (matchedBreadcrumbs) {
  const breadcrumbLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": matchedBreadcrumbs.map((crumb, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": crumb.name,
      "item": crumb.item
    }))
  };
  jsonLdBlocks.push(breadcrumbLd);
}

// 仅 compare 和 guides 设为 article，其余全为 website
const ogType = (path.startsWith("/compare/") || path.startsWith("/guides/")) ? "article" : "website";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="yandex-verification" content="91c4416c6b7be047" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Open Knowledge Format Guide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />
    ))}
    {siteConfig.analytics?.googleAnalyticsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.analytics.googleAnalyticsId}`} is:inline></script>
        <script is:inline set:html={`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${siteConfig.analytics.googleAnalyticsId}');
        `} />
      </>
    )}
    {siteConfig.analytics?.adsenseClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${siteConfig.analytics.adsenseClient}`} crossorigin="anonymous" is:inline></script>
    )}
    {siteConfig.analytics?.clarityId && (
      <script type="text/javascript" is:inline set:html={`
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "${siteConfig.analytics.clarityId}");
      `} />
    )}
  </head>
  <body>
    <Header activePath={path} />
    <slot />
    <Footer />
    <script>
      const copyButtons = document.querySelectorAll("[data-copy-text]");

      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.getAttribute("data-copy-text") || "";
          const original = button.textContent || "Copy";

          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
          } catch {
            button.textContent = "Copy failed";
          }

          window.setTimeout(() => {
            button.textContent = original;
          }, 1600);
        });
      });

      // Handle obfuscated email clicks
      const obfuscatedEmails = document.querySelectorAll(".obfuscated-email");
      obfuscatedEmails.forEach((link) => {
        link.addEventListener("click", (e) => {
          e.preventDefault();
          const user = link.getAttribute("data-user");
          const domain = link.getAttribute("data-domain");
          if (user && domain) {
            window.location.href = `mailto:${user}@${domain}`;
          }
        });
      });
    </script>
  </body>
</html>
