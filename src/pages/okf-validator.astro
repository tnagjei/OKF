---
// input: pasted Markdown from browser user
// output: client-side OKF guide profile validation result and repair guidance
// pos: OKF validator route (update rule: sync this header and src/pages README when this file changes)
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { minimumExample } from "../data/content";

const badExample = `# Missing frontmatter

This document has a heading but no simple frontmatter block.`;
---

<BaseLayout
  title="OKF Validator: Check Open Knowledge Format Markdown"
  description="Paste an OKF Markdown file, check frontmatter and links, then decide when to use the OKF Folder Validator for bundle-level checks."
  path="/okf-validator/"
>
  <main class="page-shell">
    <section class="page-hero narrow-hero">
      <p class="eyebrow">Browser-only OKF Validator</p>
      <h1>OKF validator for Open Knowledge Format files</h1>
      <p class="hero-copy">
        Paste one OKF Markdown file, check YAML frontmatter, and review missing fields. The validator runs in your browser with no upload. For a multi-file bundle, use the folder validator.
      </p>
    </section>

    <section class="validator-layout">
      <div class="validator-panel">
        <div class="tool-header">
          <h2>Paste OKF Markdown</h2>
          <div class="tool-actions">
            <button type="button" class="button secondary small" data-load-example="good">Correct example</button>
            <button type="button" class="button ghost small" data-load-example="bad">Error example</button>
          </div>
        </div>
        <textarea id="okf-input" spellcheck="false" aria-label="Markdown input"></textarea>
        <button type="button" class="button primary" id="validate-button">Validate OKF</button>
      </div>
      <aside class="validator-panel result-panel">
        <div class="tool-header">
          <h2>Result</h2>
          <button type="button" class="button ghost small" id="copy-result">Copy result</button>
        </div>
        <div id="validator-status" class="status-badge">Not checked</div>
        <pre id="validator-output" tabindex="0">Paste Markdown and run validation.</pre>
      </aside>
    </section>

    <section class="content-section">
      <h2>Validator quick actions</h2>
      <div class="panel-grid three cta-grid" aria-label="Validator quick actions">
        <article class="info-panel action-panel">
          <h3>Paste OKF Markdown</h3>
          <p>Use one Markdown file with YAML frontmatter at the top.</p>
          <a class="button secondary" href="/guides/okf-file-example/">View File Example</a>
        </article>
        <article class="info-panel action-panel">
          <h3>Check YAML frontmatter</h3>
          <p>Review type, title, description, tags, resource, and timestamp fields.</p>
          <a class="button ghost" href="/guides/okf-yaml-frontmatter/">Read Frontmatter Guide</a>
        </article>
        <article class="info-panel action-panel">
          <h3>No upload</h3>
          <p>The check runs in the browser. The pasted Markdown is not sent to this website by the validator.</p>
          <a class="button ghost" href="/okf-templates/">Copy Templates</a>
        </article>
      </div>
    </section>

    <section class="content-section">
      <h2>What this validator checks</h2>
      <ul class="check-list">
        <li>Whether a simple YAML frontmatter block exists at the top of the Markdown file.</li>
        <li>Whether the required <code>type</code> field is present.</li>
        <li>Whether recommended guide fields such as <code>title</code>, <code>description</code>, and <code>tags</code> are present.</li>
        <li>Whether <code>tags</code> uses an inline array such as <code>[okf, validator, markdown]</code>.</li>
        <li>Whether the Markdown body exists after the frontmatter block.</li>
        <li>Whether relative Markdown links should be manually reviewed in the real bundle.</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Single-file validator vs folder validator</h2>
      <p>
        Use this page when you need to repair one pasted Markdown file. Use the <a href="/okf-folder-validator/">OKF Folder Validator</a> when you need to check `index.md`, duplicate resources, and relative links across a local bundle.
      </p>
      <ul class="check-list">
        <li>Single-file check: frontmatter, required <code>type</code>, recommended metadata, body, and local link warnings.</li>
        <li>Folder check: multiple Markdown files, bundle entry point, duplicate <code>resource</code> values, and unresolved relative links.</li>
        <li>Both checks are browser-only helpers and do not prove factual accuracy or official conformance.</li>
      </ul>
    </section>

    <section class="content-section">
      <h2>Required OKF fields</h2>
      <h3>Required field</h3>
      <p>This validator treats <code>type</code> as the required OKF field.</p>
      <ul class="check-list">
        <li><code>type</code>: the concept category.</li>
      </ul>
      <h3>Recommended fields</h3>
      <p>These fields are not required, but they make snippets, previews, indexes, and bundle review easier.</p>
      <ul class="check-list">
        <li><code>title</code>: the readable file name.</li>
        <li><code>description</code>: a one-sentence summary.</li>
        <li><code>tags</code>: an inline array for grouping related files.</li>
        <li><code>resource</code>: the canonical source URL, URN, or stable identifier.</li>
      </ul>
    </section>

    <section class="compare-table-section">
      <h2>Common validation errors</h2>
      <div class="compare-table" role="table" aria-label="Common OKF validation errors and fixes">
        <div class="compare-row compare-head" role="row">
          <div role="columnheader">Error</div>
          <div role="columnheader">What it means</div>
          <div role="columnheader">Fix</div>
        </div>
        <div class="compare-row" role="row">
          <div role="cell">Missing frontmatter</div>
          <div role="cell">The file starts with Markdown body text instead of metadata.</div>
          <div role="cell">Add a YAML frontmatter block before the first heading.</div>
        </div>
        <div class="compare-row" role="row">
          <div role="cell">Missing type</div>
          <div role="cell">The file has metadata, but no concept category.</div>
          <div role="cell">Add <code>type: Website Page</code>, <code>type: API Endpoint</code>, or another clear label.</div>
        </div>
        <div class="compare-row" role="row">
          <div role="cell">Tags not array</div>
          <div role="cell">Tags are written as loose text.</div>
          <div role="cell">Use <code>tags: [okf, validator, markdown]</code>.</div>
        </div>
        <div class="compare-row" role="row">
          <div role="cell">Missing resource</div>
          <div role="cell">The file does not identify the source it describes.</div>
          <div role="cell">Add a canonical URL, URN, or stable source identifier.</div>
        </div>
        <div class="compare-row" role="row">
          <div role="cell">Relative link warning</div>
          <div role="cell">The pasted file links to another Markdown file.</div>
          <div role="cell">Use the folder validator to check whether the target exists.</div>
        </div>
        <div class="compare-row" role="row">
          <div role="cell">Empty body</div>
          <div role="cell">The file has metadata but no useful Markdown explanation.</div>
          <div role="cell">Add a focused body before publishing.</div>
        </div>
      </div>
    </section>

    <section class="content-section">
      <h2>Example OKF file</h2>
      <p>
        Use this starter file to test the validator, then read the <a href="/guides/okf-file-example/">OKF file example</a> guide for field notes and common mistakes.
      </p>
      <CodeBlock code={minimumExample} label="Correct OKF example" />
    </section>

    <section class="content-section">
      <h2>Privacy note</h2>
      <p>
        The validator runs in the browser and does not upload pasted Markdown to this website. Do not paste restricted records into any online page unless your own policy allows it.
      </p>
    </section>

    <section class="content-section">
      <h2>Related pages</h2>
      <ul class="check-list">
        <li><a href="/guides/okf-file-example/">OKF file example</a> for a full Markdown and YAML starter.</li>
        <li><a href="/guides/okf-yaml-frontmatter/">OKF YAML frontmatter</a> for required and recommended fields.</li>
        <li><a href="/okf-folder-validator/">OKF Folder Validator</a> for checking local multi-file bundles.</li>
        <li><a href="/guides/common-okf-validation-errors/">Common OKF validation errors</a> for repair steps.</li>
        <li><a href="/guides/validate-okf-bundle/">Validate OKF Bundle</a> before publishing a folder.</li>
        <li><a href="/okf-templates/">OKF Templates</a> for copy-ready starter files.</li>
      </ul>
    </section>

    <section class="faq-section">
      <p class="eyebrow">FAQ</p>
      <h2>OKF validator questions</h2>
      <details>
        <summary>Is this an official OKF validator?</summary>
        <p>No. It is an unofficial browser-only helper for learning and checking a guide profile.</p>
      </details>
      <details>
        <summary>Does it upload my Markdown?</summary>
        <p>No. The validation logic runs in the browser.</p>
      </details>
      <details>
        <summary>What field is required?</summary>
        <p>The field this guide treats as required is <code>type</code>. Other fields are recommended for clear previews and review.</p>
      </details>
      <details>
        <summary>Can it validate a full bundle?</summary>
        <p>Not fully. This page checks pasted Markdown files. Use the folder validator for local multi-file checks, then review source accuracy manually.</p>
      </details>
    </section>
  </main>

  <script define:vars={{ minimumExample, badExample }}>
    const input = document.querySelector("#okf-input");
    const validateButton = document.querySelector("#validate-button");
    const output = document.querySelector("#validator-output");
    const status = document.querySelector("#validator-status");
    const copyResult = document.querySelector("#copy-result");
    const exampleButtons = document.querySelectorAll("[data-load-example]");

    const requiredFields = ["type"];
    const guideFields = ["title", "description", "tags"];
    const recommendedFields = ["resource", "timestamp"];

    function parseFrontmatter(markdown) {
      const match = markdown.match(/^---\s*\n([\s\S]*?)\n---\s*(?:\n|$)([\s\S]*)$/);

      if (!match) {
        return { frontmatter: null, body: markdown, malformedLines: [] };
      }

      const raw = match[1];
      const fields = {};
      const malformedLines = [];
      const lines = raw.split(/\r?\n/);

      lines.forEach((line) => {
        if (!line.trim()) {
          return;
        }

        const fieldMatch = line.match(/^([A-Za-z0-9_-]+):\s*(.*)$/);

        if (fieldMatch) {
          fields[fieldMatch[1]] = fieldMatch[2].trim();
          return;
        }

        malformedLines.push(line);
      });

      return { frontmatter: fields, body: match[2], malformedLines };
    }

    function validate(markdown) {
      const errors = [];
      const warnings = [];
      const parsed = parseFrontmatter(markdown.trim());

      if (!markdown.trim()) {
        errors.push("Document is empty.");
        return { valid: false, errors, warnings };
      }

      if (!parsed.frontmatter) {
        errors.push("Missing simple frontmatter block at the top of the file.");
        return { valid: false, errors, warnings };
      }

      parsed.malformedLines.forEach((line) => {
        errors.push(`Invalid simple frontmatter line: ${line}.`);
      });

      requiredFields.forEach((field) => {
        if (!(field in parsed.frontmatter) || parsed.frontmatter[field] === "") {
          errors.push(`Missing required OKF field: ${field}.`);
        }
      });

      guideFields.forEach((field) => {
        if (!(field in parsed.frontmatter) || parsed.frontmatter[field] === "") {
          warnings.push(`Missing recommended guide field: ${field}.`);
        }
      });

      recommendedFields.forEach((field) => {
        if (!(field in parsed.frontmatter) || parsed.frontmatter[field] === "") {
          warnings.push(`Missing recommended OKF field: ${field}.`);
        }
      });

      if ("tags" in parsed.frontmatter) {
        const tagsValue = parsed.frontmatter.tags;
        const hasInlineArray = /^\[.+\]$/.test(tagsValue);

        if (!hasInlineArray) {
          errors.push("tags should use an inline array such as [okf, markdown].");
        }
      }

      if (!parsed.body.trim()) {
        warnings.push("Markdown body is empty after frontmatter.");
      }

      if (parsed.body.trim() && !/^#\s+/m.test(parsed.body)) {
        warnings.push("Markdown body has no H1 heading.");
      }

      const relativeLinks = Array.from(parsed.body.matchAll(/\[[^\]]+\]\((?!https?:|mailto:|urn:|#|\/)([^)]+)\)/g))
        .map((match) => match[1]);

      if (relativeLinks.length > 0) {
        warnings.push(`Review relative Markdown link targets manually: ${relativeLinks.join(", ")}.`);
      }

      return {
        valid: errors.length === 0,
        errors,
        warnings
      };
    }

    function renderResult(result) {
      const lines = [
        `valid: ${result.valid}`,
        "errors:",
        ...(result.errors.length ? result.errors.map((item) => `  - ${item}`) : ["  - none"]),
        "warnings:",
        ...(result.warnings.length ? result.warnings.map((item) => `  - ${item}`) : ["  - none"])
      ];

      output.textContent = lines.join("\n");
      status.textContent = result.valid ? "Valid" : "Invalid";
      status.classList.toggle("is-valid", result.valid);
      status.classList.toggle("is-invalid", !result.valid);
    }

    validateButton.addEventListener("click", () => {
      renderResult(validate(input.value));
    });

    exampleButtons.forEach((button) => {
      button.addEventListener("click", () => {
        input.value = button.getAttribute("data-load-example") === "good" ? minimumExample : badExample;
        renderResult(validate(input.value));
      });
    });

    copyResult.addEventListener("click", async () => {
      const original = copyResult.textContent;

      try {
        await navigator.clipboard.writeText(output.textContent || "");
        copyResult.textContent = "Copied";
      } catch {
        copyResult.textContent = "Copy failed";
      }

      window.setTimeout(() => {
        copyResult.textContent = original;
      }, 1600);
    });

    input.value = minimumExample;
    renderResult(validate(input.value));
  </script>
</BaseLayout>
